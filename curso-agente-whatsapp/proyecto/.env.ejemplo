# Copia este archivo como .env y cambia los valores.

# --- IA local ---
# "ollama" (recomendado) o "openai" (LM Studio, llama.cpp, Jan... cualquier servidor compatible con OpenAI)
IA_TIPO=ollama
# Ollama escucha en el puerto 11434. LM Studio en http://127.0.0.1:1234
IA_URL=http://127.0.0.1:11434
# El modelo que descargaste con: ollama pull qwen2.5:3b
MODELO=qwen2.5:3b

# --- Tú (el dueño) ---
# Tu número con código de país, sin + ni espacios. Ej. El Salvador: 503 + número
# Solo este número puede usar los comandos !programar, !plantilla, etc.
ADMIN_NUMERO=50370000000

# --- Comportamiento ---
# Cuántos mensajes recuerda el bot de cada conversación
MAX_HISTORIAL=10
# Minutos que el bot se calla en un chat cuando TÚ respondes a mano
SILENCIO_MINUTOS=60
# Responder en grupos (true/false)
RESPONDER_GRUPOS=false

# --- API local (la usan el panel y el servidor MCP) ---
API_PUERTO=3001
# Clave para proteger la API. Cámbiala por algo largo.
API_TOKEN=cambia-esta-clave
